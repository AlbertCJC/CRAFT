@model CustodianDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    Func<string, string> taskBadge = type => type switch
    {
        "REVIEW" => "cp-badge cp-badge-warning",
        "RELEASE" => "cp-badge cp-badge-success",
        "RETURN" => "cp-badge cp-badge-info",
        "OVERDUE" => "cp-badge cp-badge-error",
        _ => "cp-badge cp-badge-neutral",
    };
    Func<string, string> taskLabel = type => type switch
    {
        "REVIEW" => "Review",
        "RELEASE" => "Release",
        "RETURN" => "Return",
        "OVERDUE" => "Overdue",
        _ => type,
    };
}

<div class="cp-page-header">
    <div>
        <h1 class="cp-page-title">Custodian Dashboard</h1>
        <p class="cp-page-subtitle">Operational overview for today - reservations, releases, returns and inventory.</p>
    </div>
    <div class="cp-page-actions">
        <a href="/Custodian/Reservations" class="cp-btn cp-btn-secondary">Reservation Queue</a>
        <a href="/Returns" class="cp-btn cp-btn-primary">Process Return</a>
    </div>
</div>

<div class="cp-hero">
    <div style="min-width:0;">
        <div class="cp-hero-title">Today's operations</div>
        <div class="cp-hero-sub">
            @if (Model.OverdueEquipment > 0)
            {
                <span>@Model.OverdueEquipment overdue borrowing@(Model.OverdueEquipment == 1 ? "" : "s") need follow-up. @Model.PendingReservations request@(Model.PendingReservations == 1 ? "" : "s") await review.</span>
            }
            else
            {
                <span>@Model.PendingReservations pending request@(Model.PendingReservations == 1 ? "" : "s"), @Model.ScheduledReleasesToday release@(Model.ScheduledReleasesToday == 1 ? "" : "s") scheduled and @Model.ExpectedReturnsToday return@(Model.ExpectedReturnsToday == 1 ? "" : "s") due today.</span>
            }
        </div>
        <div class="cp-hero-chips">
            <div class="cp-chip warn"><div class="dot"></div>@Model.PendingReservations awaiting review</div>
            <div class="cp-chip"><div class="dot"></div>@Model.ActiveBorrowings active borrowings</div>
            @if (Model.OverdueEquipment > 0)
            {
                <div class="cp-chip error"><div class="dot"></div>@Model.OverdueEquipment overdue</div>
            }
        </div>
    </div>
    <div class="cp-hero-actions">
        <a href="/Custodian/Reservations" class="cp-btn cp-btn-light">Review Requests</a>
        <a href="/Custodian/Borrowings" class="cp-btn cp-btn-light">Active Borrowings</a>
    </div>
</div>

<div class="cp-section-title">At a glance</div>
<div class="cp-kpi-grid">
    <a class="cp-kpi" href="/Custodian/Reservations">
        <div class="cp-kpi-label">Pending Reservations</div>
        <div class="cp-kpi-value warn">@Model.PendingReservations</div>
    </a>
    <a class="cp-kpi" href="/Custodian/Reservations">
        <div class="cp-kpi-label">Releases Today</div>
        <div class="cp-kpi-value">@Model.ScheduledReleasesToday</div>
    </a>
    <a class="cp-kpi" href="/Custodian/Borrowings">
        <div class="cp-kpi-label">Active Borrowings</div>
        <div class="cp-kpi-value">@Model.ActiveBorrowings</div>
    </a>
    <a class="cp-kpi" href="/Returns">
        <div class="cp-kpi-label">Returns Today</div>
        <div class="cp-kpi-value">@Model.ExpectedReturnsToday</div>
    </a>
    <a class="cp-kpi" href="/Custodian/Borrowings">
        <div class="cp-kpi-label">Overdue Equipment</div>
        <div class="cp-kpi-value @(Model.OverdueEquipment > 0 ? "error" : "muted")">@Model.OverdueEquipment</div>
    </a>
    <a class="cp-kpi" href="/Returns">
        <div class="cp-kpi-label">Awaiting Inspection</div>
        <div class="cp-kpi-value">@Model.AwaitingInspection</div>
    </a>
</div>

@if (Model.LowStockCount > 0 || Model.UnderMaintenanceCount > 0)
{
    <div class="cp-section-title">Inventory alerts</div>
    <div class="cp-kpi-grid">
        <a class="cp-kpi" href="/Equipment">
            <div class="cp-kpi-label">Low Stock (threshold @Model.LowStockThreshold)</div>
            <div class="cp-kpi-value warn">@Model.LowStockCount</div>
        </a>
        <a class="cp-kpi" href="/Equipment">
            <div class="cp-kpi-label">Under Maintenance</div>
            <div class="cp-kpi-value error">@Model.UnderMaintenanceCount</div>
        </a>
    </div>
}

<div class="cp-section-title">Today's tasks</div>
<div class="cp-grid-2">
    <div class="cp-card">
        <div class="cp-card-header">Task List</div>
        <div class="cp-table-wrap" style="border:none;">
            <table class="cp-table">
                <thead>
                    <tr><th>Task</th><th>Type</th><th>When</th><th></th></tr>
                </thead>
                <tbody>
                    @if (!Model.Tasks.Any())
                    {
                        <tr><td colspan="4" class="cp-empty-state" style="padding:24px;">No tasks scheduled for today.</td></tr>
                    }
                    @foreach (var task in Model.Tasks)
                    {
                        <tr>
                            <td>
                                <div class="cp-cell-name">@task.Title</div>
                                <div class="cp-cell-sub">@task.Detail</div>
                            </td>
                            <td><span class="@taskBadge(task.Type)">@taskLabel(task.Type)</span></td>
                            <td style="font-size:11.5px;white-space:nowrap;">@task.WhenUtc.ToLocalTime().ToString("dd MMM HH:mm")</td>
                            <td class="text-center">
                                <a href="@Url.Action(task.LinkAction, task.LinkController, task.LinkId.HasValue ? new { id = task.LinkId } : null)" class="cp-btn cp-btn-secondary cp-btn-sm">Open</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="cp-card">
        <div class="cp-card-header">Inventory Alerts</div>
        <div class="cp-list">
            @if (!Model.InventoryAlerts.Any())
            {
                <div class="cp-empty-state" style="padding:20px;">No inventory alerts.</div>
            }
            @foreach (var alert in Model.InventoryAlerts)
            {
                <div class="cp-list-row">
                    <div class="cp-list-main">
                        <div class="cp-list-title">@alert.EquipmentName</div>
                        <div class="cp-list-sub">@alert.AssetCode - @alert.AvailableUnits of @alert.TotalQuantity available</div>
                    </div>
                    @if (alert.IsUnderMaintenance)
                    {
                        <span class="cp-badge cp-badge-error">Under Maintenance</span>
                    }
                    else
                    {
                        <span class="cp-badge cp-badge-warning">Low Stock</span>
                    }
                </div>
            }
        </div>
    </div>
</div>
