@using ASI.Basecode.Services.ViewModelClasses
@model ReservationReviewViewModel
@{
    ViewData["Title"] = "Reservation Review";
}

<div class="cp-page-header">
    <div>
        <h1 class="cp-page-title">Reservation Review</h1>
        <p class="cp-page-subtitle">
            @Model.ReservationNumber &middot;
            @if (Model.AssignedCustodianName == null)
            {
                <span class="cp-badge cp-badge-neutral">Shared pool</span>
            }
            else
            {
                <span>Custodian: @Model.AssignedCustodianName</span>
            }
        </p>
    </div>
    <div class="cp-page-actions">
        @if (Model.CanClaim && User.IsInRole("TECHNICIAN"))
        {
            <form method="post" asp-action="Claim" asp-route-id="@Model.ReservationId" asp-route-returnTo="review" style="display:inline;">
                @Html.AntiForgeryToken()
                <button type="submit" class="cp-btn cp-btn-primary cp-btn-sm">Assign to me</button>
            </form>
        }
        <a asp-action="Reservations" class="cp-btn cp-btn-secondary cp-btn-sm">Back to list</a>
    </div>
</div>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px;">
    <!-- Borrower -->
    <div class="cp-card">
        <div class="cp-card-header">Borrower</div>
        <div style="font-size:12.5px;display:grid;grid-template-columns:1fr 1fr;gap:6px 12px;">
            <div style="color:var(--color-text-gray);">Name</div><div>@Model.BorrowerName</div>
            <div style="color:var(--color-text-gray);">Role</div><div>@Model.BorrowerRole</div>
            <div style="color:var(--color-text-gray);">Department</div><div>@(Model.BorrowerDepartment ?? "—")</div>
            <div style="color:var(--color-text-gray);">Email</div><div>@Model.BorrowerEmail</div>
        </div>
    </div>
    <!-- Equipment -->
    <div class="cp-card">
        <div class="cp-card-header">Equipment</div>
        <div style="font-size:12.5px;display:grid;grid-template-columns:1fr 1fr;gap:6px 12px;">
            <div style="color:var(--color-text-gray);">Name</div><div>@Model.EquipmentName</div>
            <div style="color:var(--color-text-gray);">Asset Code</div><div>@Model.AssetCode</div>
            <div style="color:var(--color-text-gray);">Category</div><div>@Model.CategoryName</div>
            <div style="color:var(--color-text-gray);">Location</div><div>@(Model.LocationName ?? "—")</div>
            <div style="color:var(--color-text-gray);">Pickup Point</div><div>@(Model.PickupLocationName ?? "—")</div>
        </div>
    </div>
</div>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
    <!-- Reservation Details -->
    <div class="cp-card">
        <div class="cp-card-header">Reservation Details</div>
        <div style="font-size:12.5px;display:grid;grid-template-columns:1fr 1fr;gap:6px 12px;">
            <div style="color:var(--color-text-gray);">Status</div>
            <div><span class="cp-badge @(Model.StatusCode == "PENDING" ? "cp-badge-warning" : Model.StatusCode == "APPROVED" ? "cp-badge-info" : Model.StatusCode == "COMPLETED" ? "cp-badge-success" : "cp-badge-neutral")">@Model.StatusDescription</span></div>
            <div style="color:var(--color-text-gray);">Submitted</div><div>@Model.SubmittedAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</div>
            <div style="color:var(--color-text-gray);">Quantity</div><div>@Model.RequestedQuantity (approved: @Model.ApprovedQuantity, held: @Model.HeldQuantity)</div>
            <div style="color:var(--color-text-gray);">Start</div><div>@Model.RequestedStartAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</div>
            <div style="color:var(--color-text-gray);">Expected Return</div><div>@Model.ExpectedReturnAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</div>
            <div style="color:var(--color-text-gray);">Purpose</div><div>@(Model.Purpose ?? "—")</div>
        </div>
    </div>

    <!-- Decision -->
    <div class="cp-card">
        <div class="cp-card-header">Decision</div>
        @if (Model.CanApprove || Model.CanReject)
        {
            <form asp-action="Approve" asp-route-id="@Model.ReservationId" method="post" style="margin-bottom:16px;">
                @Html.AntiForgeryToken()
                <div class="cp-form-group">
                    <label class="cp-form-label">Approval notes (optional)</label>
                    <textarea name="notes" class="cp-textarea" rows="2"></textarea>
                </div>
                <button type="submit" class="cp-btn cp-btn-success"><i class="fa-solid fa-check"></i> Approve Reservation</button>
            </form>
            <form asp-action="Reject" asp-route-id="@Model.ReservationId" method="post">
                @Html.AntiForgeryToken()
                <div class="cp-form-group">
                    <label class="cp-form-label">Rejection reason (required)</label>
                    <textarea name="reason" class="cp-textarea" rows="2" required></textarea>
                </div>
                <button type="submit" class="cp-btn cp-btn-danger"><i class="fa-solid fa-xmark"></i> Reject Reservation</button>
            </form>
        }
        else
        {
            <p style="color:var(--color-text-gray);font-size:12.5px;">This reservation is no longer pending. Current status: @Model.StatusDescription.</p>
            @if (Model.StatusCode == "APPROVED")
            {
                <a asp-action="Release" asp-route-id="@Model.ReservationId" class="cp-btn cp-btn-success" style="margin-top:8px;">Release Equipment</a>
            }
        }
    </div>
</div>