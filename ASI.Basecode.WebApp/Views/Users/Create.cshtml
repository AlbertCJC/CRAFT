@using ASI.Basecode.Services.ViewModelClasses
@model UserFormViewModel
@{
    ViewData["Title"] = "Add User";
}

<div class="cp-page-header">
    <div>
        <div class="crumb"><div>CRAFT</div><div>/</div><div>Users</div><div>/</div><div class="cur">Add</div></div>
        <div class="cp-page-title">Add User</div>
        <div class="cp-page-subtitle">Fields marked with an asterisk are required. Staff accounts get a temporary password they must change at first sign-in.</div>
    </div>
</div>

<div class="card">
    <div class="card-bd">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <partial name="_UserForm" model="Model" />
        </form>
    </div>
</div>
