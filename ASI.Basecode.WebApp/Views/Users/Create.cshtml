@using ASI.Basecode.Services.ViewModelClasses
@model UserFormViewModel
@{
    ViewData["Title"] = "Add User";
}

<div class="page-hd">
    <div>
        <div class="crumb"><div>CRAFT</div><div>/</div><div>Users</div><div>/</div><div class="cur">Add</div></div>
        <div class="title">Add User</div>
        <div class="subtitle">Fields marked with an asterisk are required.</div>
    </div>
</div>

<div class="card">
    <div class="card-bd">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <partial name="_UserForm" model="Model" />
        </form>
    </div>
</div>
