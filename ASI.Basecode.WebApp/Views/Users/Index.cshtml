@using ASI.Basecode.Services.ViewModelClasses
@model UserIndexViewModel
@{
    ViewData["Title"] = "User Management";
}

<div class="cp-page-header">
    <div>
        <h1 class="cp-page-title">User Management</h1>
        <p class="cp-page-subtitle">Manage user accounts, roles, and departments.</p>
    </div>
    <div class="cp-page-actions">
        <a asp-action="Create" class="cp-btn cp-btn-success"><i class="fa-solid fa-plus"></i> Add User</a>
    </div>
</div>

<!-- KPI cards -->
<div class="cp-kpi-grid">
    <div class="cp-kpi">
        <div class="cp-kpi-label">Total Accounts</div>
        <div class="cp-kpi-value">@(Model.Totals?.TotalAccounts ?? 0)</div>
    </div>
    <div class="cp-kpi">
        <div class="cp-kpi-label">Students</div>
        <div class="cp-kpi-value">@(Model.Totals?.Students ?? 0)</div>
    </div>
    <div class="cp-kpi">
        <div class="cp-kpi-label">Faculty</div>
        <div class="cp-kpi-value">@(Model.Totals?.Faculty ?? 0)</div>
    </div>
    <div class="cp-kpi">
        <div class="cp-kpi-label">Custodians &amp; Admins</div>
        <div class="cp-kpi-value">@(Model.Totals?.CustodianAdmins ?? 0)</div>
    </div>
</div>

<!-- Filter bar -->
<div class="cp-filter-bar">
    <form method="get" asp-action="Index" style="display:contents;">
        <input type="text" name="search" value="@Model.Search" class="cp-input" placeholder="Search by name, account ID or email..." />
        <select name="role" class="cp-select" asp-items="@(ViewBag.RoleOptions as SelectList)"></select>
        <select name="department" class="cp-select" asp-items="@(ViewBag.DepartmentOptions as SelectList)"></select>
        <select name="status" class="cp-select" asp-items="@(ViewBag.StatusOptions as SelectList)"></select>
        <select name="pageSize" class="cp-select" style="max-width:90px;">
            <option value="10" selected="@(Model.Page?.PageSize == 10)">10</option>
            <option value="25" selected="@(Model.Page?.PageSize == 25)">25</option>
        </select>
        <button type="submit" class="cp-btn cp-btn-secondary cp-btn-sm"><i class="fa-solid fa-filter"></i> Apply</button>
        <a asp-action="Index" class="cp-btn cp-btn-secondary cp-btn-sm">Clear</a>
    </form>
</div>

<!-- Table -->
@if (!Model.Page.Items.Any())
{
    <div class="cp-empty-state">
        <div class="cp-empty-state-icon"><i class="fa-solid fa-users"></i></div>
        <div class="cp-empty-state-text">No user accounts found.</div>
    </div>
}
else
{
    <div class="cp-table-wrap">
        <table class="cp-table">
            <thead>
                <tr>
                    <th>User</th>
                    <th>Account ID</th>
                    <th>Role</th>
                    <th>Department</th>
                    <th>Contact</th>
                    <th>Status</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model.Page.Items)
                {
                    <tr>
                        <td>
                            <div style="display:flex;align-items:center;gap:8px;">
                                <div class="cp-avatar cp-avatar-sm">@(u.FirstName?.Substring(0,1))@(u.LastName?.Substring(0,1))</div>
                                <div>
                                    <a asp-action="Details" asp-route-id="@u.UserId" class="name-link"><div style="font-weight:600;">@u.FirstName @u.LastName</div></a>
                                </div>
                            </div>
                        </td>
                        <td style="font-family:monospace;font-size:11.6px;">@u.AccountIdentifier</td>
                        <td>@u.RoleName</td>
                        <td>@(u.DepartmentName ?? "—")</td>
                        <td style="font-size:11.6px;">@u.SchoolEmail</td>
                        <td>
                            <span class="cp-badge @(u.AccountStatusCode == "ACTIVE" ? "cp-badge-success" : u.AccountStatusCode == "SUSPENDED" ? "cp-badge-warning" : u.AccountStatusCode == "LOCKED" ? "cp-badge-error" : "cp-badge-neutral")">
                                @u.AccountStatusDescription
                            </span>
                        </td>
                        <td class="text-center">
                            <a asp-action="Edit" asp-route-id="@u.UserId" class="cp-btn cp-btn-secondary cp-btn-sm">Edit</a>
                            <form method="post" asp-action="Delete" asp-route-id="@u.UserId" style="display:inline;margin-left:4px;"
                                  onsubmit="return confirm('Delete this user account?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="cp-btn cp-btn-danger cp-btn-sm">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (Model.Page != null && Model.Page.TotalPages > 1)
{
    <div class="cp-pagination">
        <span class="cp-pagination-info">Page @Model.Page.Page of @Model.Page.TotalPages (@Model.Page.TotalCount records)</span>
        <ul class="cp-pagination-list">
            <li class="@(Model.Page.HasPrevious ? "" : "disabled")">
                <a asp-action="Index" asp-route-search="@Model.Search" asp-route-role="@Model.RoleId" asp-route-department="@Model.DepartmentId" asp-route-status="@Model.AccountStatusId" asp-route-page="@(Model.Page.Page - 1)">‹</a>
            </li>
            @for (var p = 1; p <= Model.Page.TotalPages; p++)
            {
                <li class="@(p == Model.Page.Page ? "active" : "")">
                    <a asp-action="Index" asp-route-search="@Model.Search" asp-route-role="@Model.RoleId" asp-route-department="@Model.DepartmentId" asp-route-status="@Model.AccountStatusId" asp-route-page="@p">@p</a>
                </li>
            }
            <li class="@(Model.Page.HasNext ? "" : "disabled")">
                <a asp-action="Index" asp-route-search="@Model.Search" asp-route-role="@Model.RoleId" asp-route-department="@Model.DepartmentId" asp-route-status="@Model.AccountStatusId" asp-route-page="@(Model.Page.Page + 1)">›</a>
            </li>
        </ul>
    </div>
}