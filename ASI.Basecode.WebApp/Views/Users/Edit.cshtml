@using ASI.Basecode.Services.ViewModelClasses
@model UserFormViewModel
@{
    ViewData["Title"] = "Edit User";
}

<div class="page-hd">
    <div>
        <div class="crumb"><div>CRAFT</div><div>/</div><div>Users</div><div>/</div><div class="cur">Edit</div></div>
        <div class="title">Edit User</div>
        <div class="subtitle">Update account details. Deleting is blocked while borrowings, reservations or inventory movements reference the user.</div>
    </div>
</div>

<div class="card">
    <div class="card-bd">
        <form asp-action="Edit" asp-route-id="@Model.UserId" method="post">
            @Html.AntiForgeryToken()
            <partial name="_UserForm" model="Model" />
        </form>
    </div>
</div>
