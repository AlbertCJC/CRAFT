@using ASI.Basecode.Data.Models
@model User
@{
    ViewData["Title"] = "User Details";
    var statusCode = Model.AccountStatus?.Code;
    var statusBg = statusCode switch
    {
        "ACTIVE" => "#EAF5EF",
        "SUSPENDED" => "#FBEAEA",
        "LOCKED" => "#FDF3E1",
        "UNVERIFIED" => "#FDF3E1",
        _ => "#EEF2F0",
    };
    var statusFg = statusCode switch
    {
        "ACTIVE" => "#0B5D3E",
        "SUSPENDED" => "#8E2F2F",
        "LOCKED" => "#8A5D0F",
        "UNVERIFIED" => "#8A5D0F",
        _ => "#3E514A",
    };
    var initials = (string.IsNullOrWhiteSpace(Model.FirstName) ? string.Empty : Model.FirstName.Trim().Substring(0, 1).ToUpperInvariant())
        + (string.IsNullOrWhiteSpace(Model.LastName) ? string.Empty : Model.LastName.Trim().Substring(0, 1).ToUpperInvariant());
}

<div class="page-hd">
    <div>
        <div class="crumb"><div>CRAFT</div><div>/</div><div>Users</div><div>/</div><div class="cur">@Model.FirstName @Model.LastName</div></div>
        <div class="title">@Model.FirstName @Model.LastName</div>
        <div class="subtitle">@Model.AccountIdentifier &middot; @(Model.Role?.RoleName ?? "No role")</div>
    </div>
    <div class="hd-actions">
        <a asp-action="Edit" asp-route-id="@Model.UserId" class="btn btn-primary">Edit</a>
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </div>
</div>

<div class="row" style="gap:20px;align-items:flex-start">
    <div style="flex:1;min-width:0">
        <div class="card">
            <div class="card-bd" style="padding:18px 20px">
                <div style="display:flex;align-items:center;gap:16px">
                    <div class="avatar" style="width:60px;height:60px;font-size:20px;border-radius:16px">@(string.IsNullOrWhiteSpace(initials) ? "U" : initials)</div>
                    <div style="min-width:0">
                        <div style="font-size:17px;font-weight:700">@Model.FirstName @Model.LastName</div>
                        <div class="hint" style="overflow-wrap:anywhere">@Model.SchoolEmail</div>
                        <div style="display:flex;gap:7px;margin-top:8px;flex-wrap:wrap">
                            <div class="badge" style="background:#E6F1F5;color:#245C6E"><div class="dot"></div>@(Model.Role?.RoleName ?? "No role")</div>
                            <div class="badge" style="background:@statusBg;color:@statusFg"><div class="dot"></div>@(Model.AccountStatus?.Description ?? "-")</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-hd"><div class="card-hd-txt"><div class="card-title">Profile</div></div></div>
            <div class="card-bd">
                <div class="kv">
                    <div class="kv-row"><div class="kv-k">School / Account ID</div><div class="kv-v">@Model.AccountIdentifier</div></div>
                    <div class="kv-row"><div class="kv-k">School Email</div><div class="kv-v">@Model.SchoolEmail</div></div>
                    <div class="kv-row"><div class="kv-k">Contact Number</div><div class="kv-v">@(string.IsNullOrWhiteSpace(Model.ContactNumber) ? "-" : Model.ContactNumber)</div></div>
                    <div class="kv-row last"><div class="kv-k">Alternate Contact</div><div class="kv-v">@(string.IsNullOrWhiteSpace(Model.AlternateContact) ? "-" : Model.AlternateContact)</div></div>
                </div>
            </div>
        </div>
    </div>

    <div style="flex:1;min-width:0">
        <div class="card">
            <div class="card-hd"><div class="card-hd-txt"><div class="card-title">Account</div></div></div>
            <div class="card-bd">
                <div class="kv">
                    <div class="kv-row"><div class="kv-k">Role</div><div class="kv-v">@(Model.Role?.RoleName ?? "-")</div></div>
                    <div class="kv-row"><div class="kv-k">Department</div><div class="kv-v">@(Model.Department?.DepartmentName ?? "-")</div></div>
                    <div class="kv-row"><div class="kv-k">Status</div><div class="kv-v"><div class="badge" style="background:@statusBg;color:@statusFg"><div class="dot"></div>@(Model.AccountStatus?.Description ?? "-")</div></div></div>
                    <div class="kv-row last"><div class="kv-k">Created</div><div class="kv-v">@Model.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</div></div>
                </div>
            </div>
        </div>
    </div>
</div>
