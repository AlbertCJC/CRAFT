@model BorrowerDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    var greeting = DateTime.Now.Hour < 12 ? "Good morning" : (DateTime.Now.Hour < 18 ? "Good afternoon" : "Good evening");
    Func<string, string> badgeBg = code => code switch
    {
        "PENDING" => "#FDF3E1", "APPROVED" => "#E6F1F5", "READY_FOR_RELEASE" => "#E2F2EE",
        "COMPLETED" => "#EAF5EF", "RETURNED" => "#EAF5EF", "ACTIVE" => "#E6F1F5",
        "PARTIALLY_RETURNED" => "#FDF3E1", "REJECTED" => "#FBEAEA", "CANCELLED" => "#EEF2F0",
        "OVERDUE" => "#FBEAEA", "LOST" => "#FBEAEA", _ => "#EEF2F0",
    };
    Func<string, string> badgeFg = code => code switch
    {
        "PENDING" => "#8A5D0F", "APPROVED" => "#245C6E", "READY_FOR_RELEASE" => "#0C6155",
        "COMPLETED" => "#0B5D3E", "RETURNED" => "#0B5D3E", "ACTIVE" => "#245C6E",
        "PARTIALLY_RETURNED" => "#8A5D0F", "REJECTED" => "#8E2F2F", "CANCELLED" => "#3E514A",
        "OVERDUE" => "#8E2F2F", "LOST" => "#8E2F2F", _ => "#3E514A",
    };
}

<div class="cp-page-header">
    <div>
        <div class="crumb"><div>CRAFT</div><div>/</div><div class="cur">Dashboard</div></div>
        <div class="cp-page-title">Dashboard</div>
        <div class="cp-page-subtitle">Your equipment activity for A.Y. 2026-2027, 1st Semester.</div>
    </div>
</div>

<div class="col">
    <div class="hero">
        <div style="min-width:0">
            <div class="hero-t">@greeting, @Model.FirstName</div>
            <div class="hero-s">
                @if (Model.OverdueItems > 0)
                {
                    <span>You have @Model.OverdueItems overdue item@(Model.OverdueItems == 1 ? "" : "s"). Returning overdue equipment unblocks new reservation requests.</span>
                }
                else if (Model.ActiveBorrowings > 0)
                {
                    <span>You have @Model.ActiveBorrowings active borrowing@(Model.ActiveBorrowings == 1 ? "" : "s"). Check the due dates below to stay on schedule.</span>
                }
                else
                {
                    <span>No equipment is currently borrowed. Browse the catalog to start a reservation.</span>
                }
            </div>
            <div class="hero-chips">
                <div class="hchip"><div class="hdot"></div>@Model.ActiveBorrowings active borrowing@(Model.ActiveBorrowings == 1 ? "" : "s")</div>
                <div class="hchip warn"><div class="hdot"></div>@Model.PendingReservations awaiting review</div>
                @if (Model.OverdueItems > 0)
                {
                    <div class="hchip err"><div class="hdot"></div>@Model.OverdueItems overdue</div>
                }
            </div>
        </div>
        <div class="acts" style="flex-shrink:0">
            <a href="/Reservations/Mine" class="btn btn-onDark">
                <svg class="ic" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 10h18"/></svg>
                <div>My Reservations</div>
            </a>
            <a href="/Reservations/Available" class="btn btn-light">
                <svg class="ic" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg>
                <div>Browse Equipment</div>
            </a>
        </div>
    </div>

    <div class="sec-title">AT A GLANCE<div class="rule"></div></div>
    <div class="metrics">
        <a href="/Borrowings/Mine" class="metric">
            <div class="metric-top"><div class="m-ic info"><svg class="ic" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="4" width="14" height="17" rx="2"/><rect x="9" y="2" width="6" height="4" rx="1"/><path d="M9 11h6M9 15h4"/></svg></div></div>
            <div><div class="m-val">@Model.ActiveBorrowings</div><div class="m-lbl">Active Borrowings</div></div>
        </a>
        <a href="/Reservations/Mine" class="metric">
            <div class="metric-top"><div class="m-ic warn"><svg class="ic" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 10h18"/></svg></div></div>
            <div><div class="m-val">@Model.PendingReservations</div><div class="m-lbl">Pending Reservations</div></div>
        </a>
        <a href="/Reservations/Mine" class="metric">
            <div class="metric-top"><div class="m-ic teal"><svg class="ic" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg></div></div>
            <div><div class="m-val">@Model.ApprovedReady</div><div class="m-lbl">Approved / Ready for Pickup</div></div>
        </a>
        <a href="/Borrowings/Mine" class="metric">
            <div class="metric-top"><div class="m-ic err"><svg class="ic" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l9.5 17h-19L12 3z"/><path d="M12 9.5v5M12 17.6v.4"/></svg></div></div>
            <div><div class="m-val">@Model.OverdueItems</div><div class="m-lbl">Overdue Items</div></div>
        </a>
        <a href="/Borrowings/History" class="metric">
            <div class="metric-top"><div class="m-ic gray"><svg class="ic" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></div></div>
            <div><div class="m-val">@Model.CompletedBorrowings</div><div class="m-lbl">Completed This Term</div></div>
        </a>
    </div>

    <div class="sec-title">ACTIVE EQUIPMENT<div class="rule"></div></div>
    <div class="row">
        <div style="flex:1.65;min-width:0">
            <div class="card">
                <div class="card-hd">
                    <div class="card-hd-txt"><div class="card-title">Active Borrowings</div><div class="card-sub">Equipment currently released to you</div></div>
                    <div class="acts"><a class="link" href="/Borrowings/Mine">View all</a></div>
                </div>
                <div class="card-bd flush">
                    <div class="tbl">
                        <div class="tr th">
                            <div class="td" style="flex:285 1 0;min-width:0">EQUIPMENT</div>
                            <div class="td" style="flex:150 1 0;min-width:0">TRANSACTION ID</div>
                            <div class="td" style="flex:60 1 0;min-width:0">QTY</div>
                            <div class="td" style="flex:150 1 0;min-width:0">RELEASE DATE</div>
                            <div class="td" style="flex:150 1 0;min-width:0">DUE DATE</div>
                            <div class="td" style="flex:182 1 0;min-width:0">STATUS</div>
                            <div class="td end" style="flex:108 1 0;min-width:0"></div>
                        </div>
                        @if (!Model.ActiveBorrowingRows.Any())
                        {
                            <div class="tr"><div class="td" style="flex:1;min-width:0;padding:24px 17px;color:#8A968F">You have no active borrowings.</div></div>
                        }
                        @foreach (var b in Model.ActiveBorrowingRows.Take(3))
                        {
                            <div class="tr">
                                <div class="td" style="flex:285 1 0;min-width:0"><div class="cellwrap"><div class="thumb" style="width:36px;height:36px"><svg class="ic" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8l-9-5-9 5v8l9 5 9-5V8z"/><path d="M3 8l9 5 9-5"/><path d="M12 13v8"/></svg></div><div class="cellname"><div class="strong">@b.EquipmentName</div><div class="sub">@b.AssetCode</div></div></div></div>
                                <div class="td" style="flex:150 1 0;min-width:0"><div class="mono">@b.TransactionNumber</div></div>
                                <div class="td" style="flex:60 1 0;min-width:0">@b.Quantity</div>
                                <div class="td" style="flex:150 1 0;min-width:0">@b.ReleasedAtUtc.ToLocalTime().ToString("dd MMM yyyy")<div class="sub">@b.ReleasedAtUtc.ToLocalTime().ToString("hh:mm tt")</div></div>
                                <div class="td" style="flex:150 1 0;min-width:0">@b.DueAtUtc.ToLocalTime().ToString("dd MMM yyyy")<div class="sub">@b.DueAtUtc.ToLocalTime().ToString("hh:mm tt")</div></div>
                                <div class="td" style="flex:182 1 0;min-width:0"><div class="badge mid" style="background:@badgeBg(b.StatusCode);color:@badgeFg(b.StatusCode)"><div class="dot"></div>@(b.IsDueToday && !b.IsOverdue ? "Due Today" : b.StatusDescription)</div></div>
                                <div class="td end" style="flex:108 1 0;min-width:0"><a class="btn btn-secondary btn-sm" href="/Borrowings/Details/@b.BorrowingId">View</a></div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
        <div style="flex:1;min-width:0">
            <div class="card">
                <div class="card-hd"><div class="card-hd-txt"><div class="card-title">Upcoming Due Dates</div></div></div>
                <div class="card-bd">
                    <div class="kv">
                        @if (!Model.UpcomingDue.Any())
                        {
                            <div class="hint" style="padding:10px 0">No upcoming due dates.</div>
                        }
                        @foreach (var due in Model.UpcomingDue)
                        {
                            <div class="kv-row">
                                <div style="display:flex;align-items:center;gap:10px">
                                    <div class="thumb" style="width:34px;height:34px"><svg class="ic" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8l-9-5-9 5v8l9 5 9-5V8z"/><path d="M3 8l9 5 9-5"/><path d="M12 13v8"/></svg></div>
                                    <div>
                                        <div class="kv-v" style="text-align:left">@due.EquipmentName</div>
                                        <div class="hint">
                                            @if (due.IsOverdue) { <text>@due.DaysOverdue day@(due.DaysOverdue == 1 ? "" : "s") overdue - return immediately</text> }
                                            else if (due.IsDueToday) { <text>Due today - @due.DueAtUtc.ToLocalTime().ToString("hh:mm tt")</text> }
                                            else { <text>Due @due.DueAtUtc.ToLocalTime().ToString("dd MMM, hh:mm tt")</text> }
                                        </div>
                                    </div>
                                </div>
                                <div class="badge" style="background:@badgeBg(due.StatusCode);color:@badgeFg(due.StatusCode)"><div class="dot"></div>@(due.IsDueToday && !due.IsOverdue ? "Due Today" : due.StatusDescription)</div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="sec-title">RESERVATION REQUESTS<div class="rule"></div></div>
    <div class="row">
        <div style="flex:1;min-width:0">
            <div class="card">
                <div class="card-hd">
                    <div class="card-hd-txt"><div class="card-title">Reservation Requests</div><div class="card-sub">Latest submissions and their status</div></div>
                    <div class="acts"><a class="link" href="/Reservations/Mine">View all</a></div>
                </div>
                <div class="card-bd flush">
                    <div class="tbl">
                        <div class="tr th">
                            <div class="td" style="flex:135 1 0;min-width:0">REQUEST ID</div>
                            <div class="td" style="flex:240 1 0;min-width:0">EQUIPMENT</div>
                            <div class="td" style="flex:178 1 0;min-width:0">REQUESTED SCHEDULE</div>
                            <div class="td" style="flex:178 1 0;min-width:0">STATUS</div>
                            <div class="td end" style="flex:98 1 0;min-width:0"></div>
                        </div>
                        @if (!Model.RecentReservations.Any())
                        {
                            <div class="tr"><div class="td" style="flex:1;min-width:0;padding:24px 17px;color:#8A968F">You have no reservation requests yet.</div></div>
                        }
                        @foreach (var r in Model.RecentReservations.Take(3))
                        {
                            <div class="tr">
                                <div class="td" style="flex:135 1 0;min-width:0"><div class="mono">@r.ReservationNumber</div></div>
                                <div class="td" style="flex:240 1 0;min-width:0">@r.EquipmentName<div class="sub">@r.AssetCode &middot; Qty @r.Quantity</div></div>
                                <div class="td" style="flex:178 1 0;min-width:0">@r.RequestedStartAtUtc.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")<div class="sub">Return @r.ExpectedReturnAtUtc.ToLocalTime().ToString("dd MMM, hh:mm tt")</div></div>
                                <div class="td" style="flex:178 1 0;min-width:0"><div class="badge mid" style="background:@badgeBg(r.StatusCode);color:@badgeFg(r.StatusCode)"><div class="dot"></div>@r.StatusDescription</div></div>
                                <div class="td end" style="flex:98 1 0;min-width:0"><a class="btn btn-secondary btn-sm" href="/Reservations/Details/@r.ReservationId">View</a></div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>
