@using ASI.Basecode.Services.ViewModelClasses
@model EquipmentFormViewModel
@{
    ViewData["Title"] = "Edit Equipment";
}

<div class="cp-page-header">
    <div>
        <div class="crumb"><div>CRAFT</div><div>/</div><div>Equipment</div><div>/</div><div class="cur">Edit Equipment</div></div>
        <div class="cp-page-title">Edit Equipment</div>
        <div class="cp-page-subtitle">Update record details and photo. Deleting a record is blocked while borrowings reference it.</div>
    </div>
</div>

<div class="card">
    <div class="card-bd">
        <form asp-action="Edit" asp-route-id="@Model.EquipmentId" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <partial name="_EquipmentForm" model="Model" />
        </form>
    </div>
</div>
