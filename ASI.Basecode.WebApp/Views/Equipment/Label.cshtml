@using ASI.Basecode.Data.Models
@model Equipment
@{
    Layout = "_PrintLayout";
    ViewData["Title"] = $"Label {Model.AssetCode}";
}
<div class="print-sheet" style="width:62mm;">
    <div style="font-size:10px;font-weight:700;letter-spacing:.12em;color:#0B5D3E;margin-bottom:6px;">CRAFT · PROPERTY OFFICE</div>
    @* Generated by QRCoder from the module matrix; contains no user-supplied markup. *@
    <div class="print-qr" aria-label="QR code for @Model.AssetCode">@Html.Raw(ViewBag.QrSvg as string)</div>
    <div class="print-code" style="margin-top:8px;">@Model.AssetCode</div>
    <div style="font-size:12.5px;font-weight:600;margin-top:2px;">@Model.EquipmentName</div>
    <div class="print-meta">@(Model.EquipmentCategory?.CategoryName)@(Model.Location != null ? " · " + Model.Location.LocationName : "")</div>
    <div class="print-meta" style="margin-top:6px;">Scan to release or return this item.</div>
</div>
