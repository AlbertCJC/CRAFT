@using ASI.Basecode.Data.Models
@model Equipment
@{
    ViewData["Title"] = "Equipment Details";
}

<div class="cp-page-header">
    <div>
        <div class="crumb"><div>CRAFT</div><div>/</div><div>Equipment</div><div>/</div><div class="cur">@Model.EquipmentName</div></div>
        <div class="cp-page-title">@Model.EquipmentName</div>
        <div class="cp-page-subtitle">@Model.AssetCode &middot; @(Model.EquipmentCategory?.CategoryName ?? "-")</div>
    </div>
    <div class="cp-page-actions">
        <a asp-action="Edit" asp-route-id="@Model.EquipmentId" class="cp-btn cp-btn-primary">Edit</a>
        <a asp-action="Index" class="cp-btn cp-btn-secondary">Back to List</a>
    </div>
</div>

<div class="row" style="gap:20px;align-items:flex-start">
    <div style="flex:1.2;min-width:0">
        <div class="card">
            <div class="eq-img" style="height:220px;overflow:hidden">
                @if (!string.IsNullOrWhiteSpace(Model.ImagePath))
                {
                    <img src="@Model.ImagePath" alt="@Model.EquipmentName" style="width:100%;height:100%;object-fit:cover" />
                }
                else
                {
                    <svg class="ic" width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8l-9-5-9 5v8l9 5 9-5V8z"/><path d="M3 8l9 5 9-5"/><path d="M12 13v8"/></svg>
                }
            </div>
            <div class="card-bd">
                <div class="kv">
                    <div class="kv-row"><div class="kv-k">Asset Code</div><div class="kv-v">@Model.AssetCode</div></div>
                    <div class="kv-row"><div class="kv-k">Category</div><div class="kv-v">@(Model.EquipmentCategory?.CategoryName ?? "-")</div></div>
                    <div class="kv-row"><div class="kv-k">Location</div><div class="kv-v">@(Model.Location?.LocationName ?? "-")</div></div>
                    <div class="kv-row"><div class="kv-k">Condition</div><div class="kv-v">@(Model.CurrentCondition?.Description ?? "-")</div></div>
                    <div class="kv-row"><div class="kv-k">Availability Status</div><div class="kv-v">@(Model.OperationalStatus?.Description ?? "-")</div></div>
                    <div class="kv-row"><div class="kv-k">Active</div><div class="kv-v">@(Model.IsActive ? "Yes" : "No")</div></div>
                    <div class="kv-row"><div class="kv-k">Created</div><div class="kv-v">@Model.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</div></div>
                    <div class="kv-row last"><div class="kv-k">Description</div><div class="kv-v">@(string.IsNullOrWhiteSpace(Model.Description) ? "-" : Model.Description)</div></div>
                </div>
            </div>
        </div>
    </div>
    <div style="flex:1;min-width:0">
        <div class="card">
            <div class="card-hd"><div class="card-hd-txt"><div class="card-title">Inventory Balance</div></div></div>
            <div class="card-bd">
                @if (Model.EquipmentInventoryBalance == null)
                {
                    <div class="empty">
                        <div class="empty-t">No inventory balance</div>
                        <div class="empty-s">No inventory balance is recorded for this equipment yet.</div>
                    </div>
                }
                else
                {
                    <div class="kv">
                        <div class="kv-row"><div class="kv-k">Total Quantity</div><div class="kv-v">@Model.EquipmentInventoryBalance.TotalQuantity</div></div>
                        <div class="kv-row"><div class="kv-k">Reserved</div><div class="kv-v">@Model.EquipmentInventoryBalance.ReservedQuantity</div></div>
                        <div class="kv-row last"><div class="kv-k">Released</div><div class="kv-v">@Model.EquipmentInventoryBalance.ReleasedQuantity</div></div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
