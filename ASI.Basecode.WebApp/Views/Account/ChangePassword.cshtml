@model ForcedPasswordChangeViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Set Your Password";
}
<div class="cp-auth-card">
    <h1 class="cp-auth-title">Set Your Password</h1>
    <p class="cp-auth-subtitle">Your account was set up with a temporary password. Choose your own to continue.</p>

    <form method="post" action="/Account/ChangePassword">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="cp-alert cp-alert-error"></div>

        <div class="cp-form-group">
            <label class="cp-form-label" asp-for="CurrentPassword">Temporary Password <span class="required">*</span></label>
            <input asp-for="CurrentPassword" type="password" class="cp-input" placeholder="Password from your administrator" autocomplete="current-password" required />
        </div>
        <div class="cp-form-group">
            <label class="cp-form-label" asp-for="NewPassword">New Password <span class="required">*</span></label>
            <input asp-for="NewPassword" type="password" class="cp-input" placeholder="Create a new password" autocomplete="new-password" required />
            <div class="cp-form-hint">At least 8 characters, with 1 uppercase letter and 1 number.</div>
        </div>
        <div class="cp-form-group">
            <label class="cp-form-label" asp-for="ConfirmPassword">Confirm Password <span class="required">*</span></label>
            <input asp-for="ConfirmPassword" type="password" class="cp-input" placeholder="Re-enter new password" autocomplete="new-password" required />
        </div>
        <button type="submit" class="cp-btn cp-btn-primary" style="width:100%;justify-content:center;">Save Password</button>
    </form>

    <form method="post" action="/Account/Logout" class="text-center" style="margin:16px 0 0;">
        @Html.AntiForgeryToken()
        <button type="submit" class="cp-auth-link" style="background:none;border:0;cursor:pointer;font:inherit;font-size:12.5px;">Sign out instead</button>
    </form>
</div>
