@model ForgotPasswordViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Forgot Password";
}
<div class="cp-auth-card">
    <h1 class="cp-auth-title">Forgot Password</h1>
    <p class="cp-auth-subtitle">Enter your school email to receive a reset link</p>

    @if (Model.LinkSent)
    {
        <div class="cp-alert cp-alert-success">
            A password reset link has been sent to your email. It is valid for 24 hours.
        </div>
        <div class="cp-alert cp-alert-success" style="word-break:break-all;">
            <strong>No mail server is configured.</strong> Open your reset link directly:<br />
            <a href="@Model.GeneratedResetUrl" class="cp-auth-link">@Model.GeneratedResetUrl</a>
        </div>
    }
    else
    {
        <form method="post" action="/Account/ForgotPassword">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="cp-alert cp-alert-error"></div>

            <div class="cp-form-group">
                <label class="cp-form-label" asp-for="Email">School Email <span class="required">*</span></label>
                <input asp-for="Email" type="email" class="cp-input" placeholder="your.name@university.edu.ph" required />
            </div>
            <button type="submit" class="cp-btn cp-btn-primary" style="width:100%;justify-content:center;">Send Reset Link</button>
        </form>
    }

    <p class="text-center" style="font-size:12.5px;color:var(--color-text-gray);margin:16px 0 0;">
        Remember your password? <a href="/Account/Login" class="cp-auth-link">Sign In</a>
    </p>
</div>
