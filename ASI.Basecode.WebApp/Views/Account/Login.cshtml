@model LoginViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Sign In";
}
<div class="cp-auth-card">
    <h1 class="cp-auth-title">Sign In</h1>
    <p class="cp-auth-subtitle">Access your CRAFT account</p>

    @if (TempData["AuthMessage"] != null)
    {
        <div class="cp-alert cp-alert-success">@TempData["AuthMessage"]</div>
    }
    @if (TempData["AuthError"] != null)
    {
        <div class="cp-alert cp-alert-error">@TempData["AuthError"]</div>
    }

    <form method="post" action="/Account/Login">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="cp-alert cp-alert-error"></div>

        <div class="cp-form-group">
            <label class="cp-form-label" asp-for="UserId">School Email or Account ID <span class="required">*</span></label>
            <input asp-for="UserId" class="cp-input" placeholder="e.g. 2023-104857 or maria.santos@university.edu.ph" autocomplete="username" required />
        </div>
        <div class="cp-form-group">
            <label class="cp-form-label" asp-for="Password">Password <span class="required">*</span></label>
            <input asp-for="Password" type="password" class="cp-input" placeholder="Enter your password" autocomplete="current-password" required />
        </div>
        <div class="d-flex justify-content-between align-items-center mb-3">
            <label class="cp-form-hint" style="margin:0;">
                <input asp-for="RememberMe" /> Remember me
            </label>
            <a href="/Account/ForgotPassword" class="cp-auth-link" style="font-size:12px;">Forgot password?</a>
        </div>
        <button type="submit" class="cp-btn cp-btn-primary" style="width:100%;justify-content:center;">Sign In</button>
    </form>

    <div class="cp-auth-divider">or</div>

    <p class="text-center" style="font-size:12.5px;color:var(--color-text-gray);margin:0;">
        Don't have an account? <a href="/Account/Register" class="cp-auth-link">Create Account</a>
    </p>
</div>
