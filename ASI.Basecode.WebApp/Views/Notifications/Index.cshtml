@using ASI.Basecode.Services.ViewModelClasses
@model NotificationsIndexViewModel
@{
    ViewData["Title"] = "Notifications";
    var search = ViewBag.Search as string;
    var status = (ViewBag.Status as string) ?? "all";
    var type = (ViewBag.Type as string) ?? "all";
}

<div class="page-hd">
    <div>
        <div class="crumb"><div>CRAFT</div><div>/</div><div class="cur">Notifications</div></div>
        <div class="title">Notifications</div>
        <div class="subtitle">Updates on your reservations, borrowings, due dates and account.</div>
    </div>
    <div class="hd-actions">
        <form asp-action="MarkAllRead" method="post" style="margin:0;">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-secondary">
                <svg class="ic" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
                <div>Mark all as read</div>
            </button>
        </form>
        <a class="btn btn-secondary" href="/Profile">Preferences</a>
    </div>
</div>

<div class="card">
    <form method="get" action="/Notifications" class="toolbar">
        <div class="search" style="flex:1">
            <svg class="ic" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg>
            <input type="text" name="search" value="@search" placeholder="Search notifications..." style="border:0;outline:0;background:transparent;flex:1;font:inherit;color:inherit" />
        </div>
        <select name="status" class="select" style="flex:0 0 130px;padding:0 10px;font:inherit;color:#42504A">
            @if (status == "all") { <option value="all" selected>All statuses</option> } else { <option value="all">All statuses</option> }
            @if (status == "unread") { <option value="unread" selected>Unread</option> } else { <option value="unread">Unread</option> }
            @if (status == "read") { <option value="read" selected>Read</option> } else { <option value="read">Read</option> }
        </select>
        <select name="type" class="select" style="flex:0 0 150px;padding:0 10px;font:inherit;color:#42504A">
            @if (type == "all") { <option value="all" selected>All types</option> } else { <option value="all">All types</option> }
            @if (type == "RESERVATION") { <option value="RESERVATION" selected>Reservations</option> } else { <option value="RESERVATION">Reservations</option> }
            @if (type == "BORROWING") { <option value="BORROWING" selected>Borrowings</option> } else { <option value="BORROWING">Borrowings</option> }
            @if (type == "ACCOUNT") { <option value="ACCOUNT" selected>Account</option> } else { <option value="ACCOUNT">Account</option> }
        </select>
        <button type="submit" class="btn btn-secondary btn-sm">Apply</button>
        <a href="/Notifications" class="btn btn-secondary btn-sm">Clear</a>
    </form>

    @if (!Model.Notifications.Any())
    {
        <div class="empty">
            <svg class="ic" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 10-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9z"/><path d="M10 21a2 2 0 004 0"/></svg>
            <div class="empty-t">No notifications</div>
            <div class="empty-s">No notifications match your search or filters.</div>
        </div>
    }

    @foreach (var n in Model.Notifications)
    {
        <div class="notif @(n.IsRead ? "" : "un")" style="padding:14px 17px">
            <div class="n-ic @(n.NotificationType == "BORROWING" ? "warn" : (n.NotificationType == "ACCOUNT" ? "" : "info"))">
                <svg class="ic" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 10-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9z"/><path d="M10 21a2 2 0 004 0"/></svg>
            </div>
            <div class="n-b" style="flex:1">
                <div class="n-t">@n.Title</div>
                <div class="n-d">@n.Message</div>
            </div>
            <div class="n-time" style="align-self:center">@n.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy - hh:mm tt")</div>
            @if (!n.IsRead)
            {
                <form asp-action="MarkRead" asp-route-id="@n.NotificationId" method="post" style="margin:0;align-self:center">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-secondary btn-sm">Mark read</button>
                </form>
            }
            else
            {
                <div class="n-dot" style="background:#DCE6E0;align-self:center"></div>
            }
        </div>
    }
</div>
