@using ASI.Basecode.Services.ViewModelClasses
@model ReservationDetailsViewModel
@{
    Layout = "_PrintLayout";
    ViewData["Title"] = $"Slip {Model.ReservationNumber}";
}
<div class="print-sheet" style="width:100mm;">
    <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:12px;">
        <div>
            <div style="font-size:10px;font-weight:700;letter-spacing:.12em;color:#0B5D3E;">CRAFT · PICKUP SLIP</div>
            <div class="print-code" style="margin-top:6px;">@Model.ReservationNumber</div>
            <div class="print-meta">@Model.StatusDescription</div>
        </div>
        @* Generated by QRCoder from the module matrix; contains no user-supplied markup. *@
        <div class="print-qr" style="width:32mm;" aria-label="QR code for @Model.ReservationNumber">@Html.Raw(ViewBag.QrSvg as string)</div>
    </div>
    <table style="width:100%;margin-top:14px;font-size:12.5px;border-collapse:collapse;">
        <tr><td class="print-meta" style="padding:3px 0;width:38%;">Borrower</td><td>@Model.BorrowerName</td></tr>
        <tr><td class="print-meta" style="padding:3px 0;">Equipment</td><td>@Model.EquipmentName (@Model.AssetCode)</td></tr>
        <tr><td class="print-meta" style="padding:3px 0;">Quantity</td><td>@(Model.ApprovedQuantity > 0 ? Model.ApprovedQuantity : Model.RequestedQuantity)</td></tr>
        <tr><td class="print-meta" style="padding:3px 0;">Pickup at</td><td>@(Model.PickupLocationName ?? "—")</td></tr>
        <tr><td class="print-meta" style="padding:3px 0;">Pickup from</td><td>@Model.RequestedStartAtUtc.ToLocalTime().ToString("ddd, dd MMM yyyy h:mm tt")</td></tr>
        <tr><td class="print-meta" style="padding:3px 0;">Return by</td><td>@Model.ExpectedReturnAtUtc.ToLocalTime().ToString("ddd, dd MMM yyyy h:mm tt")</td></tr>
    </table>
    <div class="print-meta" style="margin-top:12px;border-top:1px solid #E3EAE6;padding-top:8px;">
        Present this slip and your school ID at the Property Office. The custodian scans the code to open your release.
    </div>
</div>
