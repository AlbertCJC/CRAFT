@using Microsoft.AspNetCore.Http
@using System.Security.Claims
@inject IHttpContextAccessor HttpContextAccessor
@{
    var role = User.FindFirst(ClaimTypes.Role)?.Value;
    var isAdmin = string.Equals(role, "ADMIN", StringComparison.OrdinalIgnoreCase);
    var isCustodian = string.Equals(role, "TECHNICIAN", StringComparison.OrdinalIgnoreCase);
    var isBorrower = string.Equals(role, "STUDENT", StringComparison.OrdinalIgnoreCase)
                  || string.Equals(role, "FACULTY", StringComparison.OrdinalIgnoreCase);
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var displayName = User.Identity?.Name ?? "Guest";
    var initials = displayName.Length > 0 ? displayName.Substring(0, 1).ToUpperInvariant() : "U";
    var roleLabel = isBorrower ? "Student" : (isAdmin ? "Administrator" : "Custodian");
    var crumb = ViewData["Title"]?.ToString() ?? "Dashboard";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=1280" />
    <title>@ViewData["Title"] - CRAFT: Campus Reservation and Asset Flow Tracker</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/campuspulse.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/craft.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
</head>
<body>
<div class="craft-shell" id="craftShell">
    <header class="craft-header">
        <div class="craft-header-left">
            <button type="button" id="sidebarToggle" class="craft-burger" aria-label="Toggle navigation" aria-expanded="true">
                <span></span><span></span><span></span>
            </button>
            <div class="brand">
                <div class="brand-mark" style="width:38px;height:38px">
                    <svg class="ic" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8l-9-5-9 5v8l9 5 9-5V8z"/><path d="M3 8l9 5 9-5"/><path d="M12 13v8"/></svg>
                </div>
                <div class="brand-txt">
                    <div class="brand-name">CRAFT</div>
                    <div class="brand-sub">Campus Reservation and Asset Flow Tracker</div>
                </div>
            </div>
        </div>
        <div class="craft-header-right">
            <a class="icon-btn" href="/Notifications" title="Notifications">
                <svg class="ic" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 10-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9z"/><path d="M10 21a2 2 0 004 0"/></svg>
            </a>
            <a class="user" href="/Profile" title="Profile &amp; Settings">
                <div class="uinfo" style="align-items:flex-end">
                    <div class="uname">@displayName</div>
                    <div class="urole">@roleLabel</div>
                </div>
                <div class="avatar" style="background:#FDECE2;color:#99441A">@initials</div>
            </a>
        </div>
    </header>
    <div class="craft-body">
        <aside class="sidebar craft-sidebar" id="appSidebar">
        <div class="nav">
            @if (isBorrower)
            {
                <div class="nav-label">BORROWER PORTAL</div>
                <a class="nav-item @(controller == "Borrower" ? "active" : "")" href="/Borrower/Dashboard">
                    <svg class="ic" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/></svg>
                    <div>Dashboard</div>
                </a>
                <a class="nav-item @(controller == "Reservations" && action == "Available" ? "active" : "")" href="/Reservations/Available">
                    <svg class="ic" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8l-9-5-9 5v8l9 5 9-5V8z"/><path d="M3 8l9 5 9-5"/><path d="M12 13v8"/></svg>
                    <div>Equipment</div>
                </a>
                <a class="nav-item @(controller == "Reservations" && action != "Available" ? "active" : "")" href="/Reservations/Mine">
                    <svg class="ic" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 10h18"/></svg>
                    <div>My Reservations</div>
                </a>
                <a class="nav-item @(controller == "Borrowings" && action != "History" ? "active" : "")" href="/Borrowings/Mine">
                    <svg class="ic" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="4" width="14" height="17" rx="2"/><rect x="9" y="2" width="6" height="4" rx="1"/><path d="M9 11h6M9 15h4"/></svg>
                    <div>My Borrowings</div>
                </a>
                <a class="nav-item @(controller == "Borrowings" && action == "History" ? "active" : "")" href="/Borrowings/History">
                    <svg class="ic" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
                    <div>Borrowing History</div>
                </a>
            }
            else if (isCustodian)
            {
                <div class="nav-label">CUSTODIAN CONSOLE</div>
                <a class="nav-item @(controller == "Custodian" && action == "Dashboard" ? "active" : "")" href="/Custodian/Dashboard">
                    <svg class="ic" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/></svg>
                    <div>Dashboard</div>
                </a>
                <a class="nav-item @(controller == "Custodian" && action == "Reservations" ? "active" : "")" href="/Custodian/Reservations">
                    <svg class="ic" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 10h18"/></svg>
                    <div>Reservations</div>
                </a>
                <a class="nav-item" href="/Custodian/Reservations">
                    <svg class="ic" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s7-6 7-11a7 7 0 10-14 0c0 5 7 11 7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
                    <div>Equipment Release</div>
                </a>
                <a class="nav-item @(controller == "Custodian" && action == "Borrowings" ? "active" : "")" href="/Custodian/Borrowings">
                    <svg class="ic" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="4" width="14" height="17" rx="2"/><rect x="9" y="2" width="6" height="4" rx="1"/><path d="M9 11h6M9 15h4"/></svg>
                    <div>Active Borrowings</div>
                </a>
                <a class="nav-item @(controller == "Returns" ? "active" : "")" href="/Returns">
                    <svg class="ic" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 109-9"/><path d="M3 3v6h6"/></svg>
                    <div>Returns &amp; Inspection</div>
                </a>
                <a class="nav-item @(controller == "Equipment" ? "active" : "")" href="/Equipment">
                    <svg class="ic" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8l-9-5-9 5v8l9 5 9-5V8z"/><path d="M3 8l9 5 9-5"/><path d="M12 13v8"/></svg>
                    <div>Equipment Management</div>
                </a>
            }
            else if (isAdmin)
            {
                <div class="nav-label">ADMIN CONSOLE</div>
                <a class="nav-item @(controller == "Monitoring" && action == "Dashboard" ? "active" : "")" href="/Monitoring/Dashboard">
                    <svg class="ic" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/></svg>
                    <div>Dashboard</div>
                </a>
                <a class="nav-item @(controller == "Users" ? "active" : "")" href="/Users">
                    <svg class="ic" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.5"/><path d="M2 21a7 7 0 0114 0"/><path d="M17 5a4 4 0 010 7"/><path d="M19 21a6 6 0 00-3-5"/></svg>
                    <div>User Management</div>
                </a>
                <a class="nav-item @(controller == "Equipment" ? "active" : "")" href="/Equipment">
                    <svg class="ic" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8l-9-5-9 5v8l9 5 9-5V8z"/><path d="M3 8l9 5 9-5"/><path d="M12 13v8"/></svg>
                    <div>Equipment Administration</div>
                </a>
                <a class="nav-item @(controller == "Monitoring" && action == "Transactions" ? "active" : "")" href="/Monitoring/Transactions">
                    <svg class="ic" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h11l-3-3M20 17H9l3 3"/><path d="M4 7v10a2 2 0 002 2h1M20 17V7a2 2 0 00-2-2h-1"/></svg>
                    <div>Reservations &amp; Transactions</div>
                </a>
                <a class="nav-item @(controller == "Monitoring" && action == "Reports" ? "active" : "")" href="/Monitoring/Reports">
                    <svg class="ic" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 20h18"/><path d="M6 20V10M11 20V5M16 20v-7M21 20V8"/></svg>
                    <div>Reports</div>
                </a>
                <a class="nav-item @(controller == "Monitoring" && action == "AuditLogs" ? "active" : "")" href="/Monitoring/AuditLogs">
                    <svg class="ic" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 3h11l4 4v14H5z"/><path d="M9 12h7M9 16h7"/></svg>
                    <div>Audit Logs</div>
                </a>
                <a class="nav-item @(controller == "Settings" ? "active" : "")" href="/Settings">
                    <svg class="ic" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19 12a7 7 0 000-1l2-1-2-3-2 1a7 7 0 00-2-1l-.5-2h-4L10 7a7 7 0 00-2 1L6 7 4 10l2 1a7 7 0 000 2l-2 1 2 3 2-1a7 7 0 002 1l.5 2h4l.5-2a7 7 0 002-1l2 1 2-3-2-1z"/></svg>
                    <div>System Settings</div>
                </a>
            }
        </div>
        <div class="spacer"></div>
        <div class="sys-card">
            <div class="sys-row"><div class="live"></div><div class="sys-t">System Online</div></div>
            <div class="sys-row">
                <svg class="ic" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s7-6 7-11a7 7 0 10-14 0c0 5 7 11 7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
                <div>Property Office - Main Campus</div>
            </div>
        </div>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <form method="post" action="/Account/Logout" style="margin:0">
                @Html.AntiForgeryToken()
                <button type="submit" class="nav-item" style="background:none;border:0;width:100%;font-family:inherit;cursor:pointer;text-align:left">
                    <svg class="ic" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M10 21H5a2 2 0 01-2-2V5a2 2 0 012-2h5"/><path d="M17 16l4-4-4-4M21 12H9"/></svg>
                    <div>Sign Out</div>
                </button>
            </form>
        }
        </aside>
        <main class="craft-main">
            <div class="content">
                @RenderBody()
            </div>
        </main>
    </div>
    <footer class="craft-footer">
        <div class="footer-inner">
            <div class="footer-brand">
                <div class="footer-mark">CR</div>
                <div>
                    <div class="footer-name">CRAFT</div>
                    <div class="footer-sub">Campus Reservation and Asset Flow Tracker</div>
                </div>
            </div>
            <div class="footer-links">
                <a href="/Account/Login">Sign In</a>
                <a href="/Account/Register">Create Account</a>
                <a href="#">Support</a>
            </div>
            <div class="footer-copy">Property Office &middot; A.Y. 2026-2027</div>
        </div>
    </footer>
</div>

<div id="cp-toast-container"></div>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script>
    (function() {
        var success = '@Html.Raw(TempData["SuccessMessage"]?.ToString()?.Replace("'", "\\'") ?? "")';
        var error = '@Html.Raw(TempData["ErrorMessage"]?.ToString()?.Replace("'", "\\'") ?? "")';
        var container = document.getElementById('cp-toast-container');
        function toast(msg, cls) {
            if (!msg) return;
            var t = document.createElement('div');
            t.className = cls;
            t.textContent = msg;
            t.style.cssText = 'position:fixed;top:16px;left:50%;transform:translateX(-50%);z-index:3000;padding:10px 18px;border-radius:9px;font-size:12.6px;font-weight:600;box-shadow:0 6px 18px -8px rgba(16,45,32,.3);background:#fff;';
            t.style.border = '1px solid ' + (cls.indexOf('error') >= 0 ? '#F2D3D3' : '#CEE7D9');
            t.style.color = cls.indexOf('error') >= 0 ? '#8E2F2F' : '#0B5D3E';
            container.appendChild(t);
            setTimeout(function() { t.remove(); }, 4500);
        }
        toast(success, 'cp-toast-success');
        toast(error, 'cp-toast-error');
    })();

    // Collapsible sidebar
    (function () {
        var shell = document.getElementById('craftShell');
        var toggle = document.getElementById('sidebarToggle');
        if (!shell || !toggle) return;
        var key = 'craft.sidebar.collapsed';
        try {
            if (localStorage.getItem(key) === '1') shell.classList.add('sidebar-collapsed');
        } catch (e) { }
        toggle.addEventListener('click', function () {
            var collapsed = shell.classList.toggle('sidebar-collapsed');
            toggle.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
            try { localStorage.setItem(key, collapsed ? '1' : '0'); } catch (e) { }
        });
    })();
</script>
@RenderSection("Scripts", required: false)
</body>
</html>
